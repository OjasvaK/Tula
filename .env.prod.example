# Copy to .env on the server and fill in. Used by docker-compose.prod.yml.
# Generate secrets with: openssl rand -hex 32

# Public hostnames, each with a DNS A record pointing at the server.
# No domain? Use app.<server-ip>.sslip.io and api.<server-ip>.sslip.io.
APP_DOMAIN=app.example.com
API_DOMAIN=api.example.com

POSTGRES_PASSWORD=change-me
SECRET_KEY=change-me-to-a-long-random-string

# The dashboard signs in as this account and the password ships in the
# bundle. Create it after the first start with
#   docker compose exec backend python -m app.seed_user <username> <password>
DEMO_USERNAME=demo
DEMO_PASSWORD=change-me
