DATABASE_URL=postgresql+psycopg2://compliance:compliance@localhost:5432/compliance_db
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
UPLOAD_DIR=sample_data/images
# Comma-separated frontend origins allowed by CORS. Use the exact deployed URL in production.
ALLOWED_ORIGINS=http://localhost:5173

# Frontend build-time settings (Vite reads VITE_* when building the bundle).
VITE_API_URL=http://localhost:8000
# The dashboard signs in automatically as this account. Create it with
#   python -m app.seed_user <username> <password>
# and never reuse an admin or real regulator password here: it ships in the bundle.
VITE_DEMO_USERNAME=admin
VITE_DEMO_PASSWORD=dev-password-123
